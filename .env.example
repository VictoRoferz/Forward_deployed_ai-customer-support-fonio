# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit real secrets.

# --- Business Central OData endpoint (required) ---
# Full URL to the contact entity set. Example:
#   https://api.businesscentral.dynamics.com/v2.0/{tenant}/{env}/ODataV4/Company('YourCompany')/Contact
BC_CONTACTS_URL=

# --- Auth: pick ONE of the two blocks below ---

# Option A: OAuth2 client credentials (BC Online / SaaS, recommended)
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
# Leave default unless you have a custom scope
BC_OAUTH_SCOPE=https://api.businesscentral.dynamics.com/.default

# Option B: Basic Auth with Web Service Access Key (BC On-Premises)
# BC_USERNAME=
# BC_ACCESS_KEY=

# --- Webhook security (recommended) ---
# Fonio must send `Authorization: Bearer <this value>` on every request.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Phone matching ---
# Phone fields on the Contact entity to search (comma-separated).
BC_PHONE_FIELDS=phoneNo,mobilePhoneNo,phoneNo2,mobilePhoneNo2,privatPhoneNo,privatMobilePhoneNo
# Default country code used to generate phone format variants (49 = Germany).
BC_DEFAULT_COUNTRY_CODE=49

# Spare-part eligibility: "ordered recently" window in days (3 months ~= 90).
# A customer with any sales doc inside this window is NOT eligible to reorder.
BC_ORDER_WINDOW_DAYS=90

# Contact field holding the postal code (verification factor; confirmed on
# DE-TEST: postCode). Leave EMPTY to disable — a WRONG name here would 400
# every lookup, so confirm via Contact?$top=1 before changing (see CLAUDE.md).
BC_POSTAL_FIELD=postCode

# Max units per spare-part request. Echoed as {{max_quantity}} in
# /lookup-caller and enforced server-side in /create-request.
# MED-EL decision 2026-07-27: 30. (Code default if unset: 5.)
SPARE_MAX_QUANTITY=30

# Enforce the spoken Vorname against BC's firstName on name-path verification
# (§10 policy: Vorname UND Nachname + Geburtsdatum). 1 = on (default), 0 = off
# (fall back to Nachname+Geburtsdatum only, e.g. if STT mangles first names).
STRICT_FIRSTNAME=1

# BC Contact hierarchy (2026-08-28): a Kundennummer resolves to its single live
# PRIMARY contact (no == companyNo); sub-contacts (relatives, schools, clinics,
# old addresses) are never identities. Rows with archived=true are obsolete
# records and cannot verify or order. 1 = exclude archived (default);
# 0 = treat archived rows like live ones (if MED-EL defines "archived" differently).
VERIFY_EXCLUDE_ARCHIVED=1

# DOB-pool recovery for misheard surnames (Brongkoll call 2026-07-28): when the
# name search finds nobody, select candidates by the exact spoken birth date
# (~2-3 people tenant-wide share any date) and verify iff the Vorname matches
# positively AND the surname is >= DOB_POOL_MIN_SURNAME_SIM similar.
# 0 = off (default) — PENDING MED-EL SIGN-OFF; do not enable before that.
DOB_POOL_RECOVERY=0
DOB_POOL_MIN_SURNAME_SIM=0.7

# --- Latency (2026-08-10 retrofit — Fonio aborts tool calls at ~5 s) ---
# Concurrent BC queries per batch (verify pools, eligibility windows, phone
# probes). 1 = kill switch: identical code paths, fully serialized.
BC_MAX_PARALLEL=8
# Per-BC-query timeout in seconds (a stuck query must fail fast; OAuth: 15 s).
BC_REQUEST_TIMEOUT=4
# /verify-caller wall-clock budget: once identity is resolved, a slow
# eligibility lookup is skipped past this point and returns null ("unknown",
# prompt says "vorbehaltlich Prüfung"). Identity itself is never truncated.
BC_VERIFY_BUDGET_S=3.0

# --- Zammad (helpdesk: one ticket per call, post-processing path) ---
# Base URL of the instance, no trailing /api. e.g. https://your.zammad.com
ZAMMAD_URL=
# API token: Zammad Profile -> Token Access (needs ticket.agent perms).
# Sent as `Authorization: Token token=<...>`.
ZAMMAD_TOKEN=
# Group new tickets are filed under (must already exist in Zammad), e.g. LUMINA.
ZAMMAD_GROUP=Users
# Zammad request timeout in seconds (connector default: 10).
ZAMMAD_TIMEOUT=10
# Priority id for VIGILANCE / URGENT_MEDICAL tickets.
# Confirmed on medelde1: 1 low / 2 normal / 3 high.
ZAMMAD_URGENT_PRIORITY_ID=3

# --- ElevenLabs (voice-agent platform, runs alongside Fonio) ---
# The call-init webhook and the server tools authenticate with the SAME
# WEBHOOK_SECRET as Fonio: set `Authorization: Bearer <value>` as a
# workspace-secret header in the ElevenLabs dashboard (no extra var needed).
# HMAC secret for the post-call webhook (`ElevenLabs-Signature` header,
# HMAC-SHA256 over "timestamp.body"). Shown once when enabling the post-call
# webhook in the EL dashboard. REQUIRED: while unset, /elevenlabs/post-call
# answers 503 and creates nothing (fail-closed, decision 2026-08-13 — this
# endpoint WRITES call protocols into Zammad, unlike WEBHOOK_SECRET's older
# skip-if-unset behavior; EL retries 5xx, so events survive a late fix).
ELEVENLABS_POST_CALL_HMAC_SECRET=
# Agent ids whose calls are filed as [TEST]/internal (comma-separated) —
# the EL-side equivalent of Fonio's static internal=true tool-body field
# (test-ness must never be LLM-controlled). Keep the rollout agent id
# listed here until go-live; a listed test agent can coexist with prod.
ELEVENLABS_TEST_AGENT_IDS=
